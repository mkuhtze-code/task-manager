{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:phase5-core && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase12-integration && npm run test:phase13 && npm run test:phase14 && npm run test:phase15 && npm run test:phase16 && npm run test:phase17 && npm run test:phase18 && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:speech": "vitest run lib/speech",
    "test:collections": "vitest run lib/collections",
    "test:engine": "vitest run lib/speech lib/collections",
    "test:phase5": "vitest run lib/speech lib/engine/__tests__/captureTorture.test.ts lib/cpu/__tests__/cpuPhase5.test.ts",
    "test:phase6": "vitest run lib/cpu/__tests__/cpuPhase6.test.ts lib/thinking/v3/__tests__/behaviour.test.ts lib/thinking/v3/__tests__/fit.test.ts",
    "test:phase8": "vitest run lib/thinking/v3/__tests__/phase8.test.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase12-integration && npm run test:phase13 && npm run test:phase14 && npm run test:phase15 && npm run test:phase16 && npm run test:phase17 && npm run test:phase18 && npm run typecheck && npm run build",
    "test:phase5-core": "vitest run lib/engine/__tests__/captureTorture.test.ts lib/cpu/__tests__/cpuPhase5.test.ts",
    "test:phase7": "vitest run lib/thinking/v3/__tests__/phase7.test.ts",
    "test:phase9": "vitest run lib/engine/__tests__/phase9LanguageIntegration.test.ts",
    "test:phase10": "vitest run lib/engine/__tests__/phase10Discourse.test.ts",
    "test:phase11": "vitest run lib/engine/__tests__/phase11Vocabulary.test.ts",
    "test:phase12": "vitest run lib/engine/__tests__/phase12SemanticGrammar.test.ts",
    "test:phase12-integration": "vitest run lib/engine/__tests__/verticalSlice.test.ts -t \"understands a concrete drop-off with address, time and today as executable work\"",
    "test:phase13": "vitest run lib/engine/__tests__/phase13CaptureIntegration.test.ts",
    "test:phase14": "vitest run lib/speech/__tests__/phase14CaptureSafety.test.ts",
    "test:phase15": "vitest run lib/engine/__tests__/requestSemantic.test.ts lib/engine/__tests__/phase15CaptureContract.test.ts",
    "test:phase16": "vitest run lib/speech/__tests__/phase16CaptureDockContinuity.test.ts",
    "test:phase17": "vitest run lib/engine/__tests__/phase17CaptureReferenceGates.test.ts",
    "test:phase18": "vitest run lib/engine/__tests__/phase18CaptureDockTorture.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "fflate": "^0.8.3",
    "firebase": "10.12.2",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "web-push": "^3.6.3",
    "stripe": "^17.7.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.3",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
