# ── Dokkit environment variables ─────────────────────────────────
# Copy the values into .env.local (local dev) or the Vercel project
# settings (production). Never commit real secrets.

# Supabase — browser client (safe to expose, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side service role (bypasses RLS; server only)
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform — Routes/Places APIs for route + travel features
GOOGLE_MAPS_API_KEY=

# Web Push (VAPID) — push notification signing
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Web Messaging (FCM) — browser web-push foundation
# Public web app config; from Firebase Console → Project settings →
# General → Your apps (add a Web app). FCM web push needs a separate
# Firebase project from the Supabase backend; no service-account secrets
# belong here (they never ship to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# VAPID key shown in Firebase Console → Project settings → Cloud
# Messaging → Web push certificates. Distinct from the legacy
# NEXT_PUBLIC_VAPID_PUBLIC_KEY above.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin — server-side FCM sending (optional until web push is
# live). Raw contents of the Firebase service-account JSON for the same
# project. When absent, lib/fcm/send.ts returns a typed not_configured
# result and everything else keeps working.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Upstash Redis — rate limiting (REST API credentials).
# Optional but recommended: when absent, checkRateLimit() fails open and
# abuse protection is disabled while everything else keeps working.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret required by GET /api/check-task-timers (the cron job that
# checks active task timers and sends overdue/near-done push notifications).
# The cron caller must send it as ?secret=...
CRON_CHECK_SECRET=
