# ── Dokkit environment variables ─────────────────────────────────
# Copy the values into .env.local (local dev) or the Vercel project
# settings (production). Never commit real secrets.

# Supabase — browser client (safe to expose, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side service role (bypasses RLS; server only)
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform — Routes/Places APIs for route + travel features
GOOGLE_MAPS_API_KEY=

# Web Push (VAPID) — push notification signing
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Web Messaging (FCM)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Upstash Redis — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron secret for GET /api/check-task-timers
CRON_CHECK_SECRET=

# ── Speech STT (server — secrets) ─────────────────────────────────
# Required to enable POST /api/stt. Never use NEXT_PUBLIC for the key.
DOKKIT_STT_API_KEY=
# deepgram (default) | openai | generic
DOKKIT_STT_PROVIDER=deepgram
# Optional URL override; required when provider=generic
DOKKIT_STT_UPSTREAM_URL=
DOKKIT_STT_LANGUAGE=en-NZ

# ── Speech STT (browser) ──────────────────────────────────────────
# Prefer MediaRecorder → POST /api/stt instead of Web Speech when "1"
NEXT_PUBLIC_DOKKIT_STT_PREFER_CLOUD=
# Optional client endpoint override (default blob path uses /api/stt)
NEXT_PUBLIC_DOKKIT_STT_ENDPOINT=
NEXT_PUBLIC_DOKKIT_STT_LANGUAGE=en-NZ
